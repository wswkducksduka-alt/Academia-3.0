@charset "utf-8";

:root { --orange: #ff4e24; --orange-bright: #ff5d35; --orange-deep: #a53412; --amber-dark: #5e2208; --obsidian: #0d0b0c; --obsidian-soft: #121011; --obsidian-card: #161415; --charcoal-btn: #2b292a; --stat-bg: rgba(58, 55, 56, 0.58); --text-white: #ffffff; --text-muted: #9e9a9b; --text-dim: #736f70; --border-subtle: rgba(255, 255, 255, 0.1); --border-dark: #232021; --font-display: 'Michroma', 'Orbitron', sans-serif; --font-num: 'Orbitron', 'Michroma', sans-serif; --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; }

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; background-color: var(--obsidian); color: var(--text-white); font-family: var(--font-body); overflow-x: hidden; }

body { background-color: var(--obsidian); color: var(--text-white); overflow-x: hidden; -webkit-font-smoothing: antialiased; text-rendering: optimizelegibility; }

img { display: block; max-width: 100%; user-select: none; }

a { color: inherit; text-decoration: none; }

button, input, select { font: inherit; }

.stage-section { position: relative; width: 100%; overflow: hidden; }

@media (min-width: 1024px) {
  .stage-section { min-height: 56.25vw; }
}

@media (max-width: 767px) {
  .stage-section { min-height: 177.78vw; }
}

.triple-slashes { display: inline-block; font-family: var(--font-num); font-weight: 900; font-size: 0.85rem; letter-spacing: 0.08em; color: var(--orange); line-height: 1; }

.triple-slashes-white { color: var(--text-white); }

.section-heading-wrap { position: relative; display: inline-block; z-index: 2; }

.section-heading-wrap.align-center { text-align: center; width: 100%; }

.watermark-stroke { position: absolute; top: -0.58em; left: 0px; font-family: var(--font-display); font-size: clamp(2.8rem, 6.2vw, 6.4rem); letter-spacing: 0.06em; text-transform: uppercase; color: transparent; -webkit-text-stroke: 1.2px rgba(255, 255, 255, 0.075); pointer-events: none; user-select: none; white-space: nowrap; z-index: -1; }

.section-heading-wrap.align-center .watermark-stroke { left: 50%; transform: translateX(-50%); }

.section-title { font-family: var(--font-display); font-weight: 400; -webkit-text-stroke: 0.75px currentcolor; font-size: clamp(1.45rem, 2.65vw, 2.75rem); line-height: 1.32; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-white); }

.btn-bracket { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 28px; background: var(--charcoal-btn); border-left: 4px solid var(--orange); border-right: 4px solid var(--orange); border-top: 1px solid rgba(255, 255, 255, 0.06); border-bottom: 1px solid rgba(255, 255, 255, 0.06); color: var(--text-white); font-family: var(--font-body); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; position: relative; overflow: hidden; transition: background 0.28s, transform 0.25s, box-shadow 0.28s; }

.btn-bracket:hover { background: var(--orange); transform: translateY(-2px); box-shadow: rgba(255, 78, 36, 0.32) 0px 12px 28px; }

.btn-bracket svg { transition: transform 0.25s; }

.btn-bracket:hover svg { transform: translateX(4px); }

.btn-bracket-dark { background: var(--obsidian); border-left-color: var(--text-white); border-right-color: var(--text-white); }

.btn-bracket-dark:hover { background: rgb(31, 28, 29); }

.btn-bracket-orange-solid { background: var(--orange); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); }

.btn-bracket-orange-solid:hover { background: var(--orange-bright); }

.brand-logo { display: inline-flex; align-items: center; gap: 11px; flex-shrink: 0; }

.brand-emblem { display: inline-flex; align-items: center; justify-content: center; filter: drop-shadow(rgba(255, 78, 36, 0.35) 0px 2px 10px); }

.brand-text { display: inline-flex; align-items: baseline; gap: 5px; font-family: var(--font-display); font-size: 0.96rem; letter-spacing: 0.06em; -webkit-text-stroke: 0.5px currentcolor; }

.brand-word { color: var(--text-white); }

.brand-cm { color: var(--orange); }

.embers-canvas { position: absolute; inset: 0px; width: 100%; height: 100%; pointer-events: none; z-index: 3; }

.hero-stage { display: flex; flex-direction: column; background-color: rgb(22, 9, 4); }

.hero-bg-photo { position: absolute; inset: 0px; background-image: url("assets/images/hero-bg.jpg"); background-size: cover; background-position: center 25%; filter: saturate(1.18) contrast(1.06); z-index: 0; }

.hero-bg-vignette { position: absolute; inset: 0px; background: radial-gradient(68% 58% at 48% 36%, rgba(180, 62, 18, 0.42) 0%, rgba(72, 24, 7, 0.55) 52%, rgba(13, 11, 12, 0.92) 100%), linear-gradient(rgba(94, 34, 8, 0.55) 0%, rgba(25, 11, 6, 0.25) 55%, rgb(13, 11, 12) 100%); z-index: 1; }

.topbar { position: relative; z-index: 12; background: rgba(56, 20, 6, 0.72); border-bottom: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.73rem; color: rgba(255, 255, 255, 0.85); }

.topbar-inner { max-width: 1680px; margin: 0px auto; padding: 8px 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }

.topbar-left { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

.topbar-item { display: inline-flex; align-items: center; gap: 7px; transition: color 0.2s; }

.topbar-item svg { color: var(--orange); flex-shrink: 0; }

.topbar-item:hover { color: var(--orange); }

.topbar-sep { opacity: 0.28; }

.topbar-socials { display: flex; align-items: center; gap: 14px; }

.topbar-socials a { display: inline-flex; color: rgba(255, 255, 255, 0.88); transition: color 0.2s, transform 0.2s; }

.topbar-socials a:hover { color: var(--orange); transform: translateY(-1px); }

.navbar { position: relative; z-index: 15; background: rgba(74, 27, 7, 0.52); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); transition: background 0.3s, box-shadow 0.3s; }

.navbar.is-scrolled { position: fixed; top: 0px; left: 0px; right: 0px; background: rgba(16, 12, 11, 0.94); box-shadow: rgba(0, 0, 0, 0.55) 0px 10px 30px; }

.navbar-inner { max-width: 1920px; margin: 0px auto; height: 68px; padding-left: 28px; display: flex; align-items: center; justify-content: space-between; }

.nav-links { display: flex; align-items: center; height: 100%; padding: 0px 28px; gap: clamp(18px, 2.2vw, 38px); border-left: 1px solid rgba(255, 255, 255, 0.1); border-right: 1px solid rgba(255, 255, 255, 0.1); }

.nav-link { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); position: relative; padding: 6px 0px; transition: color 0.2s; }

.nav-link::after { content: ""; position: absolute; left: 0px; bottom: -2px; width: 0px; height: 2px; background: var(--orange); transition: width 0.25s; }

.nav-link:hover, .nav-link.active { color: var(--text-white); }

.nav-link:hover::after, .nav-link.active::after { width: 100%; }

.navbar-actions { display: flex; align-items: center; height: 100%; }

.navbar-join-btn { display: inline-flex; align-items: center; justify-content: center; height: 100%; padding: 0px clamp(20px, 2.4vw, 38px); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; color: var(--text-white); transition: color 0.2s, background 0.2s; }

.navbar-join-btn:hover { color: var(--orange); background: rgba(255, 78, 36, 0.08); }

.navbar-drawer-trigger { width: 58px; height: 100%; background: var(--orange); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; cursor: pointer; transition: background 0.2s; }

.navbar-drawer-trigger:hover { background: var(--orange-bright); }

.navbar-drawer-trigger span { display: block; width: 20px; height: 2px; background: var(--text-white); border-radius: 2px; }

.navbar-drawer-trigger span:nth-child(2) { width: 14px; transform: translateX(3px); }

.hero-content { position: relative; flex: 1 1 0%; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 1680px; margin: 0px auto; padding: 20px 32px 0px; z-index: 4; }

.hero-slanted-bars { position: absolute; inset: 0px; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 1; }

.bar-slash { position: absolute; width: clamp(95px, 11vw, 185px); height: 68%; background: linear-gradient(rgba(214, 68, 22, 0.85) 0%, rgba(188, 56, 16, 0.92) 75%, rgba(135, 38, 10, 0.72) 100%); transform: skewX(27deg); box-shadow: rgba(255, 78, 36, 0.14) 0px 20px 60px; }

.bar-slash-1 { left: 34%; top: 20%; }

.bar-slash-2 { left: 55.5%; top: 17%; }

.hero-deco-x { position: absolute; display: flex; gap: 16px; color: var(--orange); font-family: var(--font-num); font-weight: 900; font-size: clamp(1.2rem, 1.8vw, 2rem); line-height: 1; z-index: 3; pointer-events: none; text-shadow: rgba(255, 78, 36, 0.45) 0px 0px 18px; }

.hero-deco-x-top { top: 18%; right: 14%; }

.hero-deco-x-bottom { bottom: 24%; left: 3%; }

.hero-dot-matrix { position: absolute; right: 8.2%; bottom: 22%; display: grid; grid-template-columns: repeat(2, 5px); gap: 8px 11px; z-index: 3; pointer-events: none; }

.hero-dot-matrix span { width: 4px; height: 4px; border-radius: 50%; background: rgba(255, 255, 255, 0.85); }

.hero-dot-matrix span:nth-child(2n) { transform: translateY(4px); }

.hero-typography-layer { position: relative; width: 100%; z-index: 2; pointer-events: none; transform: translateY(-4%); }

.hero-heading { display: flex; flex-direction: column; width: 100%; font-family: var(--font-display); font-weight: 400; text-transform: uppercase; color: var(--text-white); }

.hero-line-top { align-self: flex-start; margin-left: 2%; font-size: clamp(1.6rem, 3.85vw, 4.3rem); letter-spacing: 0.06em; line-height: 1.1; -webkit-text-stroke: 1.2px rgb(255, 255, 255); text-shadow: rgba(0, 0, 0, 0.45) 0px 10px 30px; }

.hero-line-center { align-self: center; width: 100%; text-align: center; font-size: clamp(2.85rem, 9.2vw, 10.6rem); letter-spacing: 0.05em; line-height: 1.04; margin: 0.08em 0px; -webkit-text-stroke: 2.2px rgb(255, 255, 255); text-shadow: rgba(0, 0, 0, 0.55) 0px 16px 44px; white-space: nowrap; }

.hero-line-bottom { align-self: flex-end; margin-right: 14%; font-size: clamp(1.65rem, 4.1vw, 4.6rem); letter-spacing: 0.07em; line-height: 1.1; -webkit-text-stroke: 1.3px rgb(255, 255, 255); text-shadow: rgba(0, 0, 0, 0.45) 0px 10px 30px; }

.hero-athlete-wrap { position: absolute; bottom: 3%; left: 44%; transform: translateX(-50%); width: clamp(300px, 47vw, 760px); z-index: 5; pointer-events: none; filter: drop-shadow(rgba(0, 0, 0, 0.82) 0px 26px 32px); }

.hero-athlete-img { width: 100%; height: auto; object-fit: contain; }

.hero-mobile-cta { display: none; }

.programs-strip { position: relative; z-index: 8; background: rgb(11, 9, 10); border-top: 1px solid rgb(34, 31, 32); border-bottom: 1px solid rgb(34, 31, 32); padding: 16px; }

.programs-grid { max-width: 1920px; margin: 0px auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }

.program-card { position: relative; aspect-ratio: 16 / 9.4; background: rgb(13, 11, 12); border: 1px solid rgb(36, 33, 34); padding: 10px; overflow: hidden; cursor: pointer; transition: border-color 0.3s, transform 0.3s; }

.program-card:hover { border-color: rgba(255, 78, 36, 0.65); transform: translateY(-3px); }

.program-card-bg { width: 100%; height: 100%; object-fit: cover; object-position: right center; transition: transform 0.55s, filter 0.35s; }

.program-card:hover .program-card-bg { transform: scale(1.05); }

.program-card-overlay { position: absolute; inset: 10px; background: linear-gradient(95deg, rgba(10, 9, 9, 0.94) 0%, rgba(10, 9, 9, 0.68) 46%, rgba(10, 9, 9, 0.12) 100%); pointer-events: none; }

.program-card-content { position: absolute; inset: 10px; padding: clamp(20px, 2.4vw, 38px); display: flex; flex-direction: column; justify-content: flex-start; z-index: 2; }

.program-card-title { margin-top: 10px; font-family: var(--font-display); font-weight: 400; -webkit-text-stroke: 0.7px rgb(255, 255, 255); font-size: clamp(1.05rem, 1.55vw, 1.65rem); line-height: 1.32; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-white); }

.program-card-num { margin-top: auto; font-family: var(--font-display); font-size: clamp(2.8rem, 4.8vw, 5.2rem); line-height: 0.95; letter-spacing: 0.04em; color: transparent; -webkit-text-stroke: 1.4px rgba(255, 255, 255, 0.14); transition: -webkit-text-stroke-color 0.3s; }

.program-card:hover .program-card-num { -webkit-text-stroke-color: rgba(255, 78, 36, 0.55); }

.about-stage { background: radial-gradient(circle at 76% 42%, rgba(92, 88, 90, 0.18) 0%, rgba(13, 11, 12, 0) 52%),
    radial-gradient(circle at 52% 58%, rgba(185, 58, 20, 0.12) 0%, rgba(13, 11, 12, 0) 48%),
    var(--obsidian); display: flex; flex-direction: column; justify-content: space-between; padding-top: clamp(56px, 6vw, 105px); }

.about-smoke-glow { position: absolute; top: 12%; right: 4%; width: 52vw; height: 52vw; max-width: 760px; max-height: 760px; background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, rgba(255, 78, 36, 0.04) 38%, transparent 70%); filter: blur(36px); pointer-events: none; }

.about-container { position: relative; z-index: 4; width: 100%; max-width: 1460px; margin: 0px auto; padding: 0px clamp(24px, 4vw, 64px); display: grid; grid-template-columns: 1fr 1.22fr; align-items: center; gap: clamp(28px, 3vw, 56px); flex: 1 1 0%; }

.about-copy { max-width: 560px; padding-bottom: 32px; }

.about-description { margin: 26px 0px 34px; font-size: clamp(0.92rem, 1.02vw, 1.04rem); line-height: 1.78; color: var(--text-muted); }

.about-description strong { color: var(--text-white); font-weight: 700; }

.about-visual-cluster { position: relative; display: flex; align-items: center; justify-content: flex-end; min-height: clamp(440px, 44vw, 680px); }

.about-athlete-wrap { position: absolute; left: -2%; bottom: -64px; width: clamp(270px, 28vw, 445px); z-index: 5; pointer-events: none; filter: drop-shadow(rgba(0, 0, 0, 0.85) 0px 18px 36px); mask-image: linear-gradient(rgb(0, 0, 0) 84%, transparent 100%); }

.about-athlete-img { width: 100%; height: auto; }

.about-stats-stack { position: relative; z-index: 3; width: min(100%, 500px); display: flex; flex-direction: column; gap: 20px; padding-bottom: 36px; }

.stat-badge { background: linear-gradient(95deg, rgba(32, 30, 31, 0.72) 0%, rgba(63, 61, 62, 0.64) 100%); backdrop-filter: blur(10px); border-radius: 0px 16px 16px 0px; border-top: 1px solid rgba(255, 255, 255, 0.06); border-right: 1.5px solid rgba(255, 78, 36, 0.55); border-bottom: 2.5px solid var(--orange); padding: clamp(20px, 2vw, 28px) clamp(26px, 2.6vw, 40px) clamp(20px, 2vw, 28px) clamp(150px, 14.2vw, 224px); box-shadow: rgba(0, 0, 0, 0.42) 0px 14px 32px; transition: transform 0.28s, border-color 0.28s; }

.stat-badge:hover { transform: translateX(6px); }

.stat-badge-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }

.stat-label { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.88); }

.stat-number { font-family: var(--font-display); font-size: clamp(1.9rem, 2.9vw, 3.15rem); line-height: 1.08; letter-spacing: 0.03em; color: var(--text-white); -webkit-text-stroke: 1px rgb(255, 255, 255); display: inline-flex; align-items: flex-start; }

.stat-plus { font-size: 0.62em; margin-left: 6px; margin-top: -0.05em; }

.ribbons-crossover { position: relative; width: 100%; height: clamp(110px, 10vw, 150px); display: flex; align-items: center; justify-content: center; z-index: 7; margin-top: 10px; }

.ribbon { position: absolute; left: -6%; width: 112%; padding: 15px 0px; overflow: hidden; display: flex; }

.ribbon-dark { background: rgba(28, 26, 27, 0.92); border-top: 1px solid rgba(255, 255, 255, 0.14); border-bottom: 1px solid rgba(255, 255, 255, 0.14); transform: rotate(5.2deg); z-index: 1; }

.ribbon-orange { background: var(--orange); border-top: 1px solid rgba(255, 255, 255, 0.22); border-bottom: 1px solid rgba(0, 0, 0, 0.25); transform: rotate(0deg); z-index: 3; box-shadow: rgba(0, 0, 0, 0.65) 0px 12px 34px; }

.ribbon-track { display: flex; width: max-content; animation: 30s linear 0s infinite normal none running marqueeScroll; }

.ribbon-track-reverse { animation-direction: reverse; animation-duration: 36s; }

.ribbon-group { display: flex; align-items: center; gap: clamp(22px, 2.6vw, 40px); padding-right: clamp(22px, 2.6vw, 40px); font-family: var(--font-display); font-size: clamp(0.95rem, 1.35vw, 1.38rem); letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }

.ribbon-dark .ribbon-group span { color: transparent; -webkit-text-stroke: 1px rgba(255, 255, 255, 0.28); }

.ribbon-orange .ribbon-group span { color: rgb(14, 12, 12); -webkit-text-stroke: 0.75px rgb(14, 12, 12); }

.star-4pt, .star-4pt-outline { display: inline-block; width: 22px; height: 22px; flex-shrink: 0; background-repeat: no-repeat; background-position: center center; background-size: contain; }

